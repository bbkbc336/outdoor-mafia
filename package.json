{
  "name": "outdoor-mafia",
  "version": "1.0.0",
  "description": "교사 아우팅용 야외 어몽어스형 마피아 게임 (모바일 웹)",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "test": "node test/rules.test.js && node test/missions.test.js && node test/games.test.js",
    "test:redis": "node -e \"process.env.TEST_REDIS=1;require('./test/rules.test.js')\"",
    "test:e2e": "node test/e2e/playthrough.js",
    "test:edge": "node test/e2e/edgecases.js",
    "cf:dev": "npx wrangler@4.151.0 dev",
    "cf:deploy": "npx wrangler@4.151.0 deploy"
  },
  "engines": {
    "node": ">=18"
  }
}

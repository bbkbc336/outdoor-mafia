{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "hnd1"
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/handler?__p=/api/:path*"
    },
    {
      "source": "/print",
      "destination": "/api/handler?__p=/print"
    },
    {
      "source": "/qr.svg",
      "destination": "/api/handler?__p=/qr.svg"
    },
    {
      "source": "/host",
      "destination": "/host.html"
    },
    {
      "source": "/practice",
      "destination": "/practice.html"
    },
    {
      "source": "/screen",
      "destination": "/screen.html"
    },
    {
      "source": "/guide",
      "destination": "/guide.html"
    }
  ]
}
